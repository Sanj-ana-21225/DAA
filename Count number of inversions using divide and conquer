#include <iostream>
using namespace std;
int merge(int A[], int low, int mid, int high)
{
    int i = low;
    int j = mid + 1;
    int k = low;
    int count = 0;

    int temp[100];

    while (i <= mid && j <= high)
    {
        if (A[i] <= A[j])
        {
            temp[k] = A[i];
            i++;
        }
        else
        {
            temp[k] = A[j];
            j++;
            count = count + (mid - i + 1);
        }
        k++;
    }

    while (i <= mid)
    {
        temp[k] = A[i];
        i++;
        k++;
    }

    while (j <= high)
    {
        temp[k] = A[j];
        j++;
        k++;
    }

    for (i = low; i <= high; i++)
    {
        A[i] = temp[i];
    }

    return count;
}
int countInversion(int A[], int low, int high)
{
    int count = 0;

    if (low < high)
    {
        int mid = (low + high) / 2;

        count += countInversion(A, low, mid);
        count += countInversion(A, mid + 1, high);

        count += merge(A, low, mid, high);
    }

    return count;
}
int main()
{
    int n;
    cout << "Enter number of elements: ";
    cin >> n;
    int A[n];

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> A[i];

    int result = countInversion(A, 0, n - 1);

    cout << "Number of inversions = " << result;

    return 0;
}
