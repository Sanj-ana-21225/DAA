#include <iostream>
using namespace std;

int findSingle(int arr[], int n)
{
    int ans = 0;

    for(int i = 0; i < n; i++)
    {
        ans = ans ^ arr[i];  
    }
return ans;
}

int main()
{
    int arr[50],n;
cout<<"enter size of array:\n";
cin>>n;
cout<<"enter elements in an array:\n;
for(int i=0;i<n; i++){
cin>>arr[i];
}
    int result = findSingle(arr, n);

    cout << "Element appearing once is: " << result;

    return 0;
}
