#include<iostream>
#include<stack>
using namespace std;

void nextgreater(int arr[],int n)
{
	int result[n];
	
	for(int i=0; i<n; i++)
	result[i]=-1;
	
	stack<int>s;
	for(int i=0; i<n; i++){
		while(!s.empty() && arr[i]>arr[s.top()])
		   {
		int j=s.top();
		s.pop();
		result[j]=arr[i];
		}
		s.push(i);

}
		cout<<"next greater elements:\n ";
		for(int i=0; i<n; i++){
			cout<<arr[i]<<"-> "<<result[i]<<endl;
		}
}
int main()
{
	int n, arr[n];
	cout<<"enter size of array:\n";
	cin>>n;
	cout<<"enter array elements:\n";
	for(int i=0;i<n; i++){
		cin>>arr[i];
	}
	
	nextgreater(arr,n);
	
	return 0;
}
