#include<iostream>
#include<stack>
using namespace std;

bool isBalanced(string str)
{
	stack<char>s;
	for(int i=0;i<str.length(); i++){
		char c=str[i];
		
		if(c=='('||c=='{'||c=='['){
			s.push(c);
		}
		else if(c==')'||c=='}'||c==']')
		{
			if(s.empty())
			return false;
			
			char top=s.top();
			s.pop();
			
			if((c==')'&& top!='(')||(c=='}'&& top!='{')||(c==']'&& top!='['))
			return false;
		}
	}
}
int main()
{
	string str;
	cout<<"enter expression:\n";
	cin>>str;
	
	if(isBalanced(str))
	cout<<"Balanced parenthesis";
	else
	cout<<"not balanced";
	
	return 0;
}
